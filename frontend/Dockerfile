FROM node:20-alpine as build
WORKDIR /app

ARG VITE_LEAF_SCAN_CONFIDENCE_TRESHOLD
ARG VITE_LEAF_DETECTION_DEBUG
ENV VITE_LEAF_SCAN_CONFIDENCE_TRESHOLD=$VITE_LEAF_SCAN_CONFIDENCE_TRESHOLD
ENV VITE_LEAF_DETECTION_DEBUG=$VITE_LEAF_DETECTION_DEBUG

COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
